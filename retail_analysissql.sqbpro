<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="superstoreanalysissql.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1515"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="samplesuperstore" custom_title="0" dock_id="1" table="4,16:mainsamplesuperstore"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011900ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1">SELECT *
FROM samplesuperstore;

SELECT COUNT(*)
FROM samplesuperstore;

SELECT Sales, Profit
FROM samplesuperstore;

SELECT SUM(Sales), SUM(Profit)
FROM samplesuperstore;

SELECT 
    SUM(Sales) AS Total_Sales,
    SUM(Profit) AS Total_Profit
FROM samplesuperstore;

-- Total sales and Profit

SELECT
    SUM(Profit) / SUM(Sales) * 100 AS PROFIT_MARGIN
FROM samplesuperstore;

-- Overall Profit margin

SELECT
    Region,
    SUM(Sales) AS TOTAL_SALES,
    SUM(Profit) AS TOTAL_PROFIT
FROM samplesuperstore
GROUP BY Region;
--Sales and Profit by region 

SELECT
    Region,
    SUM(Sales) AS Total_Sales,
    SUM(Profit) AS Total_Profit,
    SUM(Profit) / SUM(Sales) * 100 AS Profit_Margin
FROM samplesuperstore
GROUP BY Region;

-- Profit Margin by Region

SELECT
    Category,
    SUM(Sales) AS Total_Sales,
    SUM(Profit) AS Total_Profit
FROM samplesuperstore
GROUP BY Category;
-- Sales and profit by Category 

SELECT
    Category,
    SUM(Sales) AS Total_Sales,
    SUM(Profit) AS Total_Profit,
    SUM(Profit) / SUM(Sales) * 100 AS Profit_Margin
FROM samplesuperstore
GROUP BY Category;
--Profit Margin by Category

SELECT
    &quot;Sub-Category&quot;,
    SUM(PROFIT) AS Total_Profit
FROM samplesuperstore
GROUP BY &quot;Sub-Category&quot;;
--Profit by sub-category 

SELECT
    Discount,
    SUM(Profit) AS Total_Profit
FROM samplesuperstore
GROUP BY Discount
ORDER BY Discount;

SELECT
    Discount,
    COUNT(*) AS Number_of_Rows,
    SUM(Profit) AS Total_Profit
FROM samplesuperstore
GROUP BY Discount
ORDER BY Discount;

SELECT
    Discount,
    COUNT(*) AS Number_of_Rows,
    SUM(Profit) AS Total_Profit,
    SUM(Profit)/ COUNT(*) AS Average_Profit
FROM samplesuperstore
GROUP BY Discount
ORDER BY Discount;

--Discount vs Profit

SELECT
    &quot;Sub-Category&quot;,
    SUM(Profit) AS Total_Profit
FROM samplesuperstore
GROUP BY &quot;Sub-Category&quot;
ORDER BY Total_Profit DESC;

SELECT
    Category,
    SUM(Quantity) AS Total_Quantity,
    SUM(Profit) AS Total_Profit
FROM samplesuperstore
GROUP BY Category;

SELECT
    Category,
    SUM(Quantity) AS Total_Quantity,
    SUM(Profit) AS Total_Profit,
    SUM(Profit)/SUM(Quantity) AS Profit_Per_Unit
FROM samplesuperstore
GROUP BY Category;

--Profit per unit by category 

SELECT
    CASE
        WHEN Profit &gt;= 0 THEN 'Profitable'
        ELSE 'Loss'
    END AS Profit_Status,
    COUNT(*) AS Number_of_Rows
FROM samplesuperstore
GROUP BY Profit_Status;

--Profitable VS loss making rows(CASE)</sql><current_tab id="0"/></tab_sql></sqlb_project>
